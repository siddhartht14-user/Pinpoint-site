{
  "headers": [
    {
      "source": "/swatches/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/BuzziTone",
      "destination": "https://buzzi-acoustic-3.vercel.app"
    },
    {
      "source": "/BuzziTone/(.*)",
      "destination": "https://buzzi-acoustic-3.vercel.app/$1"
    },
    {
      "source": "/Pinpoint",
      "destination": "/"
    },
    {
      "source": "/Pinpoint/(.*)",
      "destination": "/$1"
    }
  ]
}
